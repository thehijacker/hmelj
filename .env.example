# Hmelj configuration — the mail servers are NOT configured here anymore.
# Users sign in with a Hmelj account, then attach their own IMAP/SMTP
# mailboxes (any provider) through the in-app account wizard.

PORT=3000
HOST=0.0.0.0
# DATA_DIR=./data

# Allow new Hmelj users to register on the login page (default true).
# Set to false once your household/team have created their accounts.
# The very first user can always register.
# ALLOW_SIGNUP=true

# Key for encrypting stored mailbox passwords (AES-256-GCM).
# If unset, Hmelj auto-generates DATA_DIR/secret.key — back that file up!
# HMELJ_SECRET is the only name read. Earlier releases called it HMAIL_SECRET
# (and GOLOB_SECRET before that); if you are carrying an older .env over, move
# the VALUE across under the new name — do not set a fresh one, or every stored
# mailbox password decrypts against the wrong key and is gone.
# HMELJ_SECRET=change-me-long-random-string

# How often the background poller checks each mail account for new mail
# (milliseconds, minimum 30000). Default 120000 (2 minutes).
# SYNC_INTERVAL_MS=120000

# How often the background poller asks each synced address book what has
# changed (milliseconds, minimum 60000). Default 300000 (5 minutes). Much
# cheaper than the mail poll — a run that finds nothing costs one request per
# address book and transfers no contacts — so this is longer only because
# contacts change far less often than mail arrives.
# CONTACT_SYNC_INTERVAL_MS=300000

# How often the background poller checks each synced calendar (milliseconds,
# minimum 60000). Default 300000 (5 minutes).
# CALENDAR_SYNC_INTERVAL_MS=300000

# How far back and ahead a calendar is kept, in days.
#
# These affect Microsoft 365 and Exchange ONLY. Those two expand repeating
# events themselves rather than handing over the rules, so their calendars are
# known over exactly this range and no further — scroll past it and they look
# empty. CalDAV and Google store the rules, so they are known for all time
# whatever these say. Widening them costs a slightly larger response per poll,
# not more requests.
# CALENDAR_WINDOW_PAST_DAYS=120
# CALENDAR_WINDOW_FUTURE_DAYS=550

# Where the SQLite message cache (cache.sqlite) lives. Defaults to DATA_DIR.
# The cache is written to constantly by the background sync, and those
# writes are synchronous — if DATA_DIR is on network-attached storage
# (NFS/SMB/NAS mount), point just the cache at fast local disk here instead.
# CACHE_DIR=/var/lib/hmelj-cache

# Log verbosity: error | warn | info | debug (default info).
# LOG=info

# Web Push (background new-mail notifications, incl. with Hmelj fully
# closed). Generate a keypair with `npm run vapid-keys` and set both below —
# notifications stay off until these are set. VAPID_SUBJECT should be a
# mailto: or https: address identifying you; some push services (FCM) use it
# to reach you if your server misbehaves.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# How long a push service (Mozilla's autopush for Firefox, FCM for Chrome,
# Apple's relay for Safari) may keep holding a new-mail notification for a
# device it cannot currently reach, in seconds. Default 900 (15 minutes).
#
# This matters more than it looks: a browser only talks to its push service
# while it is RUNNING, so everything sent while it was closed is queued there
# and delivered in one burst at startup. A long TTL turns switching a laptop
# on into a replay of every notification it missed — mail you have very likely
# already read on another device. 15 minutes still covers a suspended laptop,
# a dropped Wi-Fi link or an Android Doze window, and anything older has
# stopped being news: the mail is in the mailbox and the app shows it
# correctly the moment it is opened.
#
# Raise it if you would rather see late notifications than miss them; 0 means
# "deliver now or not at all".
# PUSH_TTL_SECONDS=900

# Kill switch for the background sync poller + SQLite cache (default true).
# Set to false to run Hmelj fully live: no background polling, no local
# message cache, unified Inbox/Sent views fetched fresh from IMAP on every
# request. Slower, but nothing to go stale or drift from the mail server —
# useful while shaking out sync-related issues.
# CACHE_ENABLED=true

# How much RAM may be spent holding attachment bytes that have already been
# extracted once (default 32 MB). Opening an attachment is expensive out of
# proportion to its size: every backend answers by pulling the WHOLE message
# down and running mailparser over it to cut one part out, so a second
# attachment on the same message, or the same one again, would otherwise pay
# that price all over again. Memory only — nothing here is ever written to
# disk, and it is emptied when Hmelj restarts. 0 disables it.
# ATTACHMENT_CACHE_MB=32

# Push notifications for the native Android app. Android's WebView implements
# no Service Worker Push API at all, on any version, so that build relays
# through Firebase Cloud Messaging instead of Web Push (see server/push.js and
# public/js/app.js — the bridge is called CodexaPush there, a name inherited
# from the WebView shell this app was built from and kept because renaming it
# would break every already-installed APK).
#
# Needs a Firebase service-account JSON key: Firebase console -> Project
# settings -> Service accounts -> Generate new private key. This is a SERVER
# credential — never put it in the app, the APK, or version control.
#
# Entirely optional: Web Push for real browsers and installed PWAs works
# unaffected without it. Defaults to DATA_DIR/fcm-service-account.json, so the
# common case needs no env var at all — just drop the file there (chmod 600,
# same as secret.key) and restart. Only set this to point somewhere else, and
# prefer an absolute path: a relative one resolves against the process's
# working directory, which under systemd is rarely where you expect.
# FCM_SERVICE_ACCOUNT_PATH=/path/to/fcm-service-account.json

# Public base URL this instance is reachable at, e.g. https://mail.example.com
# (no trailing slash). Only OAuth needs it: the redirect_uri sent to Microsoft
# or Google has to match the one registered with them byte for byte, and this
# is also what Settings -> Admin -> OAuth providers shows you to copy into the
# app registration. Left empty it is derived per request from
# X-Forwarded-Proto / X-Forwarded-Host / Host, which is right for the usual
# nginx/Caddy setup — set it explicitly if that guess ever comes out wrong.
# A mismatch here is by far the most common way for OAuth sign-in to fail.
# HMELJ_PUBLIC_URL=https://mail.example.com

# OAuth client registrations. These are the ENV alternative to filling the same
# fields in Settings -> Admin -> OAuth providers; set here they win over the
# stored ones and the Admin fields become read-only ("Set by environment
# variables"). Useful for a containerised deploy that would rather inject
# configuration than write DATA_DIR/oauth.json.
#
# Microsoft (Outlook.com / Microsoft 365) is registered in Azure as a PUBLIC
# client — PKCE, no client secret, which is why there is no MS_OAUTH_SECRET.
# Tenant is "common" unless you registered a single-tenant app.
# MS_OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# MS_OAUTH_TENANT=common
#
# Google/Gmail is the opposite: its only server-side redirect flow is the "Web
# application" client, which IS confidential and does require the secret.
# GOOGLE_OAUTH_CLIENT_ID=…apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-…
