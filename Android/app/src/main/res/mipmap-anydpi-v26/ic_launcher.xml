<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+, which is the whole minSdk range, so the raster
     mipmap-*/ic_launcher.png files are legacy fallbacks no device actually uses).
     The two drawables are generated by scripts/gen-icon.py from the same geometry
     as public/icons/icon.svg, so the phone icon and the web icon cannot drift. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
